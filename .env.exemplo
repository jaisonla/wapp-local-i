# Porta local (o túnel aponta para http://localhost:3000)
PORT=3000

# Segredos: gere com "npm run configurar"
API_TOKEN=
MCP_SEGREDO=
PAINEL_USUARIO=jaison
PAINEL_SENHA=

# Número do robô com DDI e DDD, só dígitos (usado no código de pareamento)
NUMERO_ROBO=

# Proteções contra bloqueio
INTERVALO_MIN_MS=2500
INTERVALO_MAX_MS=6000
LIMITE_DIA=200
# Se preenchido, só envia para estes destinos (números, ids ou nomes de grupo, separados por vírgula)
DESTINOS_PERMITIDOS=
# Se "sim", só envia para pessoas e grupos que já aparecem nas conversas do robô
EXIGIR_CONVERSA_EXISTENTE=nao

# Endereço do painel, usado nos alertas
LINK_PAINEL=https://web.jaison.eng.br/conectar

# Alertas opcionais pelo Telegram quando o WhatsApp cair
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Arquivos grandes: o robô baixa do link em vez de receber o conteúdo pelo conector.
# Repositório privado onde o Claude coloca os arquivos (dono/repositório) e a pasta dentro dele
CAIXA_SAIDA=
CAIXA_PASTA=saida
# Token do GitHub só de leitura nesse repositório (fine-grained, Contents: Read-only)
GITHUB_TOKEN=
# Outros sites permitidos para baixar arquivos, separados por vírgula (GitHub já está liberado)
HOSTS_ARQUIVOS=
LIMITE_ARQUIVO_MB=64
